{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "rootDir": "src",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    "useUnknownInCatchVariables": false,
    "declaration": true,
    "declarationMap": true,
    "noEmitOnError": true,
    "outDir": "lib",
    "sourceMap": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["lib", "node_modules", "test"]
}
