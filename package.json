{
  "name": "dsh-cicd",
  "type": "module",
  "version": "0.1.0",
  "description": "Per-project CI/CD pipelines for DeepSeek Harness: list, trigger, track, read logs, and cancel. Currently ships an Alibaba Cloud DevOps (Yunxiao Flow) adapter.",
  "author": "yinfoyuan",
  "license": "MIT",
  "homepage": "https://github.com/yinfoyuan/dsh-cicd#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yinfoyuan/dsh-cicd.git"
  },
  "bugs": {
    "url": "https://github.com/yinfoyuan/dsh-cicd/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "pipeline",
    "ci",
    "cd",
    "cicd",
    "yunxiao",
    "alibaba-cloud-devops",
    "flow",
    "typescript"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "AGENTS.md",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "cordis.patch.yml",
    "docs",
    "examples",
    "lib",
    "src"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit && tsc -p test/tsconfig.json --noEmit",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --cache --fix",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run build && npm test && node scripts/check-docs.mjs",
    "release": "release-it",
    "release:dry": "release-it --dry-run",
    "commitlint": "commitlint",
    "prepare": "husky",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.2 <5",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2 <0.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint-react/eslint-plugin": "^5.28.6",
    "@release-it/conventional-changelog": "^12.0.2",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "esbuild": "^0.25.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-slop": "^0.1.3",
    "eslint-plugin-sonarjs": "^4.2.2",
    "husky": "^9.1.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "release-it": "^21.1.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
